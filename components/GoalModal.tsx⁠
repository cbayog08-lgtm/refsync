import React, { useState } from 'react';
import { View, Text, Modal, TouchableOpacity, FlatList, StyleSheet } from 'react-native';

interface Player {
  id: string;
  number: number;
  name: string;
  is_starter: boolean;
}

interface GoalModalProps {
  visible: boolean;
  onClose: () => void;
  onSaveGoal: (playerNumber: number, team: 'home' | 'away') => void;
  homePlayers: Player[];
  awayPlayers: Player[];
  homeTeamName: string;
  awayTeamName: string;
}

export const GoalModal: React.FC<GoalModalProps> = ({
  visible,
  onClose,
  onSaveGoal,
  homePlayers,
  awayPlayers,
  homeTeamName,
  awayTeamName,
}) => {
  const [selectedTeam, setSelectedTeam] = useState<'home' | 'away'>('home');

  const activePlayers = selectedTeam === 'home' ? homePlayers : awayPlayers;

  return (
    <Modal visible={visible} animationType="slide" transparent>
      <View style={styles.overlay}>
        <View style={styles.container}>
          <Text style={styles.title}>REGISTRAR GOL</Text>

          {/* Selector de Equipo */}
          <View style={styles.teamSelector}>
            <TouchableOpacity
              style={[styles.teamBtn, selectedTeam === 'home' && styles.teamBtnActive]}
              onPress={() => setSelectedTeam('home')}
            >
              <Text style={styles.teamText}>{homeTeamName}</Text>
            </TouchableOpacity>

            <TouchableOpacity
              style={[styles.teamBtn, selectedTeam === 'away' && styles.teamBtnActive]}
              onPress={() => setSelectedTeam('away')}
            >
              <Text style={styles.teamText}>{awayTeamName}</Text>
            </TouchableOpacity>
          </View>

          <Text style={styles.subtitle}>Selecciona el goleador:</Text>

          {/* Lista de Jugadores (Dorsal + Nombre) */}
          <FlatList
            data={activePlayers}
            keyExtractor={(item) => item.id}
            renderItem={({ item }) => (
              <TouchableOpacity
                style={styles.playerItem}
                onPress={() => {
                  onSaveGoal(item.number, selectedTeam);
                  onClose();
                }}
              >
                <View style={styles.dorsalBadge}>
                  <Text style={styles.dorsalText}>{item.number}</Text>
                </View>
                <Text style={styles.playerName}>{item.name}</Text>
              </TouchableOpacity>
            )}
          />

          <TouchableOpacity style={styles.cancelBtn} onPress={onClose}>
            <Text style={styles.cancelText}>Cancelar</Text>
          </TouchableOpacity>
        </View>
      </View>
    </Modal>
  );
};

const styles = StyleSheet.create({
  overlay: { flex: 1, backgroundColor: 'rgba(0,0,0,0.8)', justifyContent: 'center', padding: 20 },
  container: { backgroundColor: '#121212', borderRadius: 12, padding: 20, maxHeight: '80%' },
  title: { color: '#00FF66', fontSize: 20, fontWeight: 'bold', textAlign: 'center', marginBottom: 15 },
  subtitle: { color: '#888', fontSize: 14, marginBottom: 10 },
  teamSelector: { flexDirection: 'row', marginBottom: 15, gap: 10 },
  teamBtn: { flex: 1, padding: 12, backgroundColor: '#222', borderRadius: 8, alignItems: 'center' },
  teamBtnActive: { backgroundColor: '#00FF66' },
  teamText: { color: '#FFF', fontWeight: 'bold' },
  playerItem: { flexDirection: 'row', alignItems: 'center', padding: 12, backgroundColor: '#1E1E1E', borderRadius: 8, marginBottom: 8 },
  dorsalBadge: { width: 36, height: 36, borderRadius: 18, backgroundColor: '#333', justifyContent: 'center', alignItems: 'center', marginRight: 12 },
  dorsalText: { color: '#00FF66', fontWeight: 'bold', fontSize: 16 },
  playerName: { color: '#FFF', fontSize: 16, fontWeight: '500' },
  cancelBtn: { marginTop: 10, padding: 12, alignItems: 'center' },
  cancelText: { color: '#FF4444', fontSize: 16 }
});
